# copy file nay thanh .env va sua theo he thong
# .env khong commit len git (da co trong .gitignore)

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eaut_db
POSTGRES_USER=eaut_admin
POSTGRES_PASSWORD=eaut_password

# pgAdmin (tuy chon, chi de xem database qua browser)
PGADMIN_EMAIL=admin@eaut.edu.vn
PGADMIN_PASSWORD=admin123

# Email service - gui thong bao bai tap / thong bao GV-Admin qua Gmail SMTP
# De trong SMTP_USER/SMTP_PASS -> tinh nang email tu dong tat (app van chay).
# Cach lay App Password: Google Account > Security > 2-Step Verification (bat)
#   > App passwords > tao password 16 ky tu (KHONG phai mat khau Gmail thuong).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Trung tam Ngoai khoa EAUT
